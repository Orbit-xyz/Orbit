# ---------------------------------------------------------------------------
# Orbit — Arc (EVM) rail configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the few blanks. `.env` is gitignored; this
# template is committed.
#
#   cp .env.example .env
#
# Network values below are PUBLIC and verified against the official Circle
# docs at https://docs.arc.io (fetched 2026-09-20). Only secrets are blank.
# ---------------------------------------------------------------------------

# --- Network: Arc Testnet ----------------------------------------------------
# Source: https://docs.arc.io/arc/references/connect-to-arc
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=wss://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# Arc Mainnet, for later. Chain ID 5042.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_CHAIN_ID=5042
# ARC_EXPLORER_URL=https://explorer.arc.io

# --- USDC --------------------------------------------------------------------
# TASK 6.0 RESOLVED: USDC on Arc satisfies IERC20 directly at a system address.
# There is no wrapped USDC — the native and ERC-20 interfaces share one balance.
# Docs: "On Arc that step is unnecessary because the native USDC token already
# satisfies IERC20 directly."  OrbitPuller therefore works unmodified.
#
# Same address on BOTH testnet and mainnet.
# Source: https://docs.arc.io/arc/references/contract-addresses
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# 6 decimals on the ERC-20 interface (the native gas view uses 18).
# Arc's own guidance: rely solely on the ERC-20 interface for balances and
# transfers. OrbitPuller does exactly that.
ARC_USDC_DECIMALS=6

# Permit2, at the canonical cross-chain address — for gasless approvals later.
ARC_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Deployment --------------------------------------------------------------
# Two supported signing paths. Deploy.s.sol handles either.
#
# A) Encrypted keystore (safer — nothing plaintext on disk):
#      cast wallet import orbit-deployer --interactive
#      forge script ... --account orbit-deployer --broadcast
#    Leave DEPLOYER_PRIVATE_KEY blank in that case.
#
# B) Key in this file (simpler — forge auto-loads it, no password prompt):
#      DEPLOYER_PRIVATE_KEY=0xabc123...
#      forge script ... --broadcast
#
# If you choose B: this file is gitignored so it will not reach GitHub, but the
# key sits in plaintext where any process on this machine can read it — including
# anything in node_modules. Acceptable for a throwaway testnet wallet funded from
# a faucet. NEVER put a key here for a wallet that touches mainnet or real funds.
DEPLOYER_PRIVATE_KEY=

# >>> YOU FILL THIS <<< — after Task 6.4 deploys. Backend + frontend read it.
ORBIT_PULLER_ADDRESS=

# --- Contract verification ---------------------------------------------------
# Confirmed 2026-09-20: explorer.testnet.arc.io runs Blockscout v11.3.1, which
# verifies WITHOUT an API key. Leave ARC_SCAN_API_KEY blank.
#   forge verify-contract <ADDR> src/OrbitPuller.sol:OrbitPuller \
#     --verifier blockscout --verifier-url $ARC_SCAN_VERIFY_URL --chain-id 5042002
ARC_SCAN_VERIFY_URL=https://explorer.testnet.arc.io/api/
ARC_SCAN_API_KEY=

# --- Reference (not read by code) --------------------------------------------
# Testnet faucet. On Arc, gas IS USDC, so this single tap funds both gas and
# test settlements.
ARC_FAUCET_URL=https://faucet.circle.com
