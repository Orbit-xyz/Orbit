# ---------------------------------------------------------------------------
# Orbit Merchant API — environment template
# ---------------------------------------------------------------------------
#   cp .env.example .env    then fill in the secrets.
# `.env` is gitignored; this template is committed so the config shape is known.
# ---------------------------------------------------------------------------

PORT=3001

# --- Supabase ----------------------------------------------------------------
# >>> SECRET <<< Service-role key. Server-side only — never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stellar / Soroban rail --------------------------------------------------
ORBIT_CONTRACT_ID=CAZBZBUWBSQYK2RZ6WHMXVDLIQHSU5WD7ANZYL6HLNSCRUOTNYCDYQNG
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# SAC USDC uses 7 decimals on this rail (Arc uses 6 — see Build_Guide Task 6.6).
STELLAR_USDC_DECIMALS=7

# --- Arc (EVM) rail ----------------------------------------------------------
# Verified live 2026-09-20. USDC is the native gas token AND satisfies IERC20
# at the address below — the native and ERC-20 views share one balance.
# Always read balances through the ERC-20 interface (6 decimals), never the
# native one (18 decimals), or amounts will be off by 10^12.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
ORBIT_PULLER_ADDRESS=0x2c0c751e40b89a01309548DaBe7937754447aC92
